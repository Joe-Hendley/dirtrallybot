# dirtrallybot configuration template.
#
# Copy this to `.env` in the working directory and fill it in. A missing `.env`
# is a fatal error. The process environment takes precedence over values set
# here, so you can override any key without editing the file.

# Discord bot token. Required.
TOKEN=

# Discord application ID, used to register the slash commands. Required.
APP=

# Guild ID where the `!cars` / `!stages` debug commands are allowed. Optional.
TESTSERVER=

# How a generated challenge's blanks are filled in. Optional; defaults to
# `biased` when unset.
#   biased        - leans towards stages, cars and weather that have had good
#                   thumbs-up / thumbs-down feedback
#   random        - picks uniformly at random
#   deterministic - replays a fixed sequence (for debugging)
RANDOMISER=biased
